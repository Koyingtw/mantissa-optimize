package kokkos
package kokkos newton off neigh full
# bulk Cu lattice, EAM（改自 bench/in.eam：可調大小/步數、thermo 15 位有效數字）
variable        x index 8
variable        y index 8
variable        z index 8
variable        nsteps index 1000
variable        nthermo index 100

variable        xx equal 20*$x
variable        xx equal 20*8
variable        yy equal 20*$y
variable        yy equal 20*8
variable        zz equal 20*$z
variable        zz equal 20*8

units           metal
atom_style      atomic

lattice         fcc 3.615
Lattice spacing in x,y,z = 3.615 3.615 3.615
region          box block 0 ${xx} 0 ${yy} 0 ${zz}
region          box block 0 160 0 ${yy} 0 ${zz}
region          box block 0 160 0 160 0 ${zz}
region          box block 0 160 0 160 0 160
create_box      1 box
Created orthogonal box = (0 0 0) to (578.4 578.4 578.4)
  1 by 1 by 1 MPI processor grid
create_atoms    1 box
Created 16384000 atoms
  using lattice units in orthogonal box = (0 0 0) to (578.4 578.4 578.4)
  create_atoms CPU = 1.191 seconds

pair_style      eam
pair_coeff      1 1 Cu_u3.eam
Reading eam potential file Cu_u3.eam with DATE: 2007-06-11

velocity        all create 1600.0 376847 loop geom

neighbor        1.0 bin
neigh_modify    every 1 delay 5 check yes

fix             1 all nve

timestep        0.005
thermo_style    custom step temp epair etotal press
thermo_modify   format float %22.15e norm yes
thermo          ${nthermo}
thermo          100

run             ${nsteps}
run             2000

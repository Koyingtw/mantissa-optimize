# Python environments and caches
**/.venv/
**/__pycache__/
apps/pyscf-venv/

# Build products and binaries
*.so
*.o
gh200/bin/gemm_mant_bench
gh200/bin/fp64_kernel_bench
gh200/shim/test_f32
gh200/shim/test_shim
apps/mfem-bench/ex1_bench.build-*

# Profiler databases (hundreds of MB each; the summaries are in the logs and results)
*.sqlite
*.nsys-rep

# Third-party source trees and builds; our changes live in apps/patches/
apps/cp2k/
apps/GEMMul8/
apps/lammps/
apps/mfem/
apps/sw4/
apps/sw4-tpl/
apps/exageostat-deps/

# Pseudopotentials copied into run directories (originals are in apps/qe-inputs/)
gh200/logs/**/*.UPF
gh200/logs/**/*.upf

# Stray output
gh200/HPL.out

# Copyrighted full-text PDFs used for citation checks (kept locally only)
gh200/refs/pdf/
# ExaGeoStat writes its synthetic data into every run directory; gh200/logs/exageostat/*/data.csv keeps the copy each
# experiment actually read
apps/logs/exageostat_run_*/configurations/
gh200/logs/exageostat/*/gen/configurations/

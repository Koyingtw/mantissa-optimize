variable        z index 8
variable        nsteps index 1000
variable        nthermo index 100

variable        xx equal 20*$x
variable        xx equal 20*1
variable        yy equal 20*$y
variable        yy equal 20*1
variable        zz equal 20*$z
variable        zz equal 20*1

units           metal
atom_style      atomic

lattice         fcc 3.615

+template<class DeviceType>
+void PairEAMKokkos<DeviceType>::truncate_spline_mantissa(t_host_ffloat_2d_n7 h_frho,
+                                                        t_host_ffloat_2d_n7 h_rhor,
+                                                        t_host_ffloat_2d_n7 h_z2r)
+{
+  const MantTrunc::Config &mc = MantTrunc::config();
+  if (!mc.active) return;
+  t_host_ffloat_2d_n7 tabs[3] = {h_frho, h_rhor, h_z2r};
+  const char *names[3] = {"PairEAMKokkos frho_spline", "PairEAMKokkos rhor_spline",
+                          "PairEAMKokkos z2r_spline"};
+  for (int t = 0; t < 3; t++) {
+    MantTrunc::Stats st;
+    auto h = tabs[t];
+    // rows 1..n are filled by interpolate(); row 0 is unused (zero)
+    for (int i = 0; i < (int) h.extent(0); i++)
+      for (int m = 0; m < (int) h.extent(1); m++)
+        for (int k = 0; k < (int) h.extent(2); k++)
+          MantTrunc::apply_inplace(h(i,m,k), mc, st);
+    if (comm->me == 0) utils::logmesg(lmp, st.str(names[t], mc));
+  }
+}

--- /dev/null
+++ b/src/KOKKOS/mant_trunc.h
@@ -0,0 +1,99 @@
+/* -*- c++ -*- ----------------------------------------------------------
+   Mantissa truncation of stored FP64 coefficient tables (research only).
+
+   Environment:
+     MANT_BITS=<k>   keep k explicit mantissa bits (0..51); unset or >=52 -> no-op
+     MANT_ROUND=trunc|nearest   (default trunc)
+   trunc  : clear the low (52-k) bits of the IEEE-754 binary64 pattern
+   nearest: add 1<<(52-k-1) first (round half away from zero in magnitude),
+            then clear the low (52-k) bits. NaN/Inf are left untouched.
+------------------------------------------------------------------------- */
+
+#ifndef LMP_MANT_TRUNC_H
+#define LMP_MANT_TRUNC_H
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+namespace LAMMPS_NS {
+namespace MantTrunc {
+
+struct Config {
+  int bits = 52;
+  bool nearest = false;
+  bool active = false;
+};
+
+inline const Config &config()
+{
+  static const Config cfg = [] {
+    Config c;
+    const char *s = std::getenv("MANT_BITS");
+    if (s && *s) {
+      int k = std::atoi(s);
+      if (k >= 0 && k < 52) {
+        c.bits = k;
+        c.active = true;
+      }
+    }
+    const char *r = std::getenv("MANT_ROUND");
+    if (r && std::strcmp(r, "nearest") == 0) c.nearest = true;
+    return c;
+  }();
+  return cfg;
+}
+
+inline double apply(double v, const Config &c)
+{
+  if (!c.active) return v;
+  uint64_t u;
+  std::memcpy(&u, &v, sizeof(u));
+  if (((u >> 52) & 0x7ffULL) == 0x7ffULL) return v;    // NaN / Inf
+  const int drop = 52 - c.bits;
+  if (c.nearest) u += 1ULL << (drop - 1);
+  u &= ~((1ULL << drop) - 1ULL);
+  std::memcpy(&v, &u, sizeof(v));
+  return v;
+}
+
+// running statistics for one array
+struct Stats {
+  long n = 0, changed = 0;
+  double max_rel = 0.0;
+  void add(double before, double after)
+  {
+    ++n;
+    if (before != after) {
+      ++changed;
+      if (before != 0.0) {
+        double rel = std::fabs((after - before) / before);
+        if (rel > max_rel) max_rel = rel;
+      }
+    }
+  }
+  std::string str(const char *name, const Config &c) const
+  {
+    char buf[256];
+    std::snprintf(buf, sizeof(buf),
+                  "[MANT] %s: MANT_BITS=%d MANT_ROUND=%s values=%ld changed=%ld max_rel_change=%.3e\n",
+                  name, c.bits, c.nearest ? "nearest" : "trunc", n, changed, max_rel);
+    return std::string(buf);
+  }
+};
+
+// truncate in place and accumulate statistics
+inline void apply_inplace(double &v, const Config &c, Stats &st)
+{
+  const double b = v;
+  v = apply(v, c);
+  st.add(b, v);
+}
+
+}    // namespace MantTrunc
+}    // namespace LAMMPS_NS
+
+#endif

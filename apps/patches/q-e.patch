+!----------------------------------------------------------------------------
+! mantissa-optimize research knob: keep only some of the 52 FP64 fraction bits
+! of a complex array on the device, in place. Used by regterg/cegterg to reduce
+! psi/hpsi/spsi once where they are produced, so every later GEMM reads reduced
+! operands without extra copies. Environment (all unset = no-op):
+!   QE_MANT_BITS=<k>        fixed number of kept bits
+!   QE_MANT_ROUND=nearest   round instead of truncating
+!   QE_MANT_ADAPT=<m>       tolerance-aware: bits = ceil(-log2(ethr)) + m, where
+!                           ethr is the current Davidson threshold, clamped to
+!                           [QE_MANT_MIN (default 16), 52]
+SUBROUTINE qe_mant_set_ethr( ethr )
+  USE util_param, ONLY : DP
+  IMPLICIT NONE
+  REAL(DP), INTENT(IN) :: ethr
+  REAL(DP) :: cur_ethr
+  COMMON /qe_mant_c/ cur_ethr
+  cur_ethr = ethr
+END SUBROUTINE qe_mant_set_ethr
+!
+SUBROUTINE qe_mant_reduce( n, x )
+  USE util_param, ONLY : DP
+  IMPLICIT NONE
+  INTEGER, INTENT(IN) :: n
+  COMPLEX(DP), INTENT(INOUT) :: x(n)
+  REAL(DP) :: cur_ethr
+  COMMON /qe_mant_c/ cur_ethr
+  INTEGER, SAVE :: bits = -1, adapt = -1, minb = 16, last = -1
+  LOGICAL, SAVE :: nearest = .FALSE.
+  INTEGER :: i, ios, b
+  INTEGER(8) :: ur, ui, mask, half
+  CHARACTER(len=32) :: s
+  IF ( bits < 0 ) THEN
+     bits = 52
+     CALL get_environment_variable( 'QE_MANT_BITS', s, status=ios )
+     IF ( ios == 0 ) READ( s, * ) bits
+     bits = MAX( 0, MIN( 52, bits ) )
+     CALL get_environment_variable( 'QE_MANT_ADAPT', s, status=ios )
+     IF ( ios == 0 ) READ( s, * ) adapt
+     CALL get_environment_variable( 'QE_MANT_MIN', s, status=ios )
+     IF ( ios == 0 ) READ( s, * ) minb
+     CALL get_environment_variable( 'QE_MANT_ROUND', s, status=ios )
+     nearest = ( ios == 0 .AND. TRIM(s) == 'nearest' )
+  END IF
+  b = bits
+  IF ( adapt >= 0 .AND. cur_ethr > 0.0_DP ) &
+     b = MAX( minb, MIN( 52, CEILING( -LOG( cur_ethr ) / LOG( 2.0_DP ) ) + adapt ) )
+  IF ( b /= last ) THEN
+     WRITE( *, '(5x,a,i3,a,es9.2)' ) 'qe_mant: kept fraction bits =', b, '   ethr =', cur_ethr
+     last = b
+  END IF
+  IF ( b >= 52 ) RETURN
+  mask = NOT( ISHFT( 1_8, 52 - b ) - 1_8 )
+  half = 0_8
+  IF ( nearest ) half = ISHFT( 1_8, 51 - b )
+  !$acc parallel loop present(x)
+  DO i = 1, n
+     ur = IAND( TRANSFER( DBLE( x(i) ), 1_8 ) + half, mask )
+     ui = IAND( TRANSFER( AIMAG( x(i) ), 1_8 ) + half, mask )
+     x(i) = CMPLX( TRANSFER( ur, 1.0_DP ), TRANSFER( ui, 1.0_DP ), kind=DP )
+  END DO
+END SUBROUTINE qe_mant_reduce

diff --git a/src/MantTrunc.h b/src/MantTrunc.h
new file mode 100644
index 0000000..9a8a2ba
--- /dev/null
+++ b/src/MantTrunc.h
@@ -0,0 +1,63 @@
+// Mantissa truncation research hook (mantissa-optimize project, GH200).
+// Controlled by environment variables; a no-op unless MANT_BITS is set:
+//   MANT_BITS=<k>              keep k explicit mantissa bits of each double (0..51)
+//   MANT_ROUND=trunc|nearest   trunc (default) = zero the low 52-k bits,
+//                              nearest = add 1<<(52-k-1) to the bit pattern first
+// NaN/Inf are left untouched. k >= 52 (or unset / invalid) means no change.
+#ifndef SW4_MANT_TRUNC_H
+#define SW4_MANT_TRUNC_H
+
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+namespace manttrunc {
+
+struct Config {
+  int bits = 52;         // 52 = native, no-op
+  bool nearest = false;  // default: truncation toward zero (mantissa zeroing)
+  bool active() const { return bits >= 0 && bits < 52; }
+};
+
+inline Config from_env() {
+  Config c;
+  const char* b = std::getenv("MANT_BITS");
+  if (b && *b) {
+    char* end = nullptr;
+    long v = std::strtol(b, &end, 10);
+    if (end != b && v >= 0 && v < 52) c.bits = static_cast<int>(v);
+  }
+  const char* r = std::getenv("MANT_ROUND");
+  if (r && (std::strcmp(r, "nearest") == 0 || std::strcmp(r, "rn") == 0))
+    c.nearest = true;
+  return c;
+}
+
+inline double apply(double x, const Config& c) {
+  std::uint64_t u;
+  std::memcpy(&u, &x, sizeof u);
+  if (((u >> 52) & 0x7ffULL) == 0x7ffULL) return x;  // NaN / Inf
+  const int drop = 52 - c.bits;
+  if (c.nearest) u += (1ULL << (drop - 1));
+  u &= ~((1ULL << drop) - 1ULL);
+  std::memcpy(&x, &u, sizeof u);
+  return x;
+}
+
+// Applies in place on host-accessible memory; returns number of values changed.
+inline std::size_t apply_array(double* p, std::size_t n, const Config& c) {
+  if (!c.active()) return 0;
+  std::size_t changed = 0;
+  for (std::size_t i = 0; i < n; i++) {
+    const double y = apply(p[i], c);
+    if (std::memcmp(&y, &p[i], sizeof y) != 0) {
+      p[i] = y;
+      changed++;
+    }
+  }
+  return changed;
+}
+
+}  // namespace manttrunc
+
+#endif  // SW4_MANT_TRUNC_H
diff --git a/configs/make.gh200 b/configs/make.gh200

+++ b/configs/make.gh200
@@ -0,0 +1,38 @@
+# SW4 (raja branch) on GH200: nvcc (CUDA 13.2 from NVHPC 26.5) + RAJA v2026.07.1, sm_90
+# No Umpire / HDF5 / Proj / FFTW. Copy to configs/make.inc before running make.
+NH = /software/nvhpc/Linux_aarch64/26.5
+CUDA_HOME = $(NH)/cuda/13.2
+MPI_HOME = $(NH)/comm_libs/13.2/hpcx/hpcx-2.50/ompi5
+RAJA_HOME = /nfs/home/koying/mantissa-optimize/apps/sw4-tpl/install
+NVHPC_LIB = $(NH)/compilers/lib
+
+FC = gfortran
+LINKER = g++
+CXX = $(PREP) nvcc
+
+proj = no
+ckernel = yes
+openmp = no
+raja_cuda = yes
+hdf5 = no
+zfp = no
+EXTRA_FORT_FLAGS = -fallow-argument-mismatch -std=legacy
+
+GIT_VERSION := "$(shell git describe --abbrev=4 --dirty --always --tags)"
+
+MORE_FLAGS = -DENABLE_MPI_TIMING_BARRIER=1 -DSW4_STAGED_MPI_BUFFERS=1 -DUSE_DIRECT_INVERSE=1 \
+  -DSW4_USE_CMEM=1 -DSW4_GHCOF_NO_GP_IS_ZERO=1 \
+  -DSW4_GIT_VERSION=\"$(GIT_VERSION)\"
+
+DLINKFLAGS = -arch=sm_90
+LINKFLAGS =
+
+EXTRA_CXX_FLAGS = -O3 -lineinfo -use_fast_math $(MORE_FLAGS) -DDISABLE_PREFETCH=1 -ccbin g++ \
+  -Xcompiler=-Wno-template-body -std=c++20 --expt-extended-lambda --expt-relaxed-constexpr -restrict \
+  -arch=sm_90 -I$(CUDA_HOME)/include -I$(RAJA_HOME)/include -I$(MPI_HOME)/include --x cu \
+  -DRAJA_USE_CUDA -DSW4_CROUTINES -DRAJA_USE_RESTRICT_PTR -DCUDA_CODE -DENABLE_CUDA -dc
+
+EXTRA_LINK_FLAGS = -L$(NVHPC_LIB) -Wl,-rpath,$(NVHPC_LIB) -llapack -lblas \
+  -L$(CUDA_HOME)/lib64 -Wl,-rpath,$(CUDA_HOME)/lib64 -lcudart -L$(CUDA_HOME)/lib64/stubs -lcuda \
+  -L$(RAJA_HOME)/lib -lRAJA -lcamp -lcudadevrt -lnvidia-ml \
+  -L$(MPI_HOME)/lib -Wl,-rpath,$(MPI_HOME)/lib -lmpi -lgfortran -lstdc++ -lm -ldl

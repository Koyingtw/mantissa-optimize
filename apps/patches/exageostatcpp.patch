diff --git a/src/configurations/Configurations.cpp b/src/configurations/Configurations.cpp
index f7e03a9..c731cba 100644
--- a/src/configurations/Configurations.cpp
+++ b/src/configurations/Configurations.cpp
@@ -137,17 +137,18 @@ void Configurations::ValidateConfiguration() {
     if (GetMaxRank() == -1) {
         SetMaxRank(1);
     }
-//#else
+#else
+    // GH200 port: the "//#else" above made the StarPU build demand --datapath, i.e. synthetic data could not
+    // be generated at all; restored the runtime split as on the upstream devel branch.
     if(GetMaxRank() == -1){
         SetMaxRank(GetDenseTileSize() / 2);
     }
     if (mDictionary.find("tolerance") == mDictionary.end()) {
         SetTolerance(8);
     }
-     if (GetDataPath().empty()) {
+     if (GetDataPath().empty() && !GetIsSynthetic()) {
         throw domain_error("You need to set the data path, before starting");
     }
-#else
     if(GetMeanTrendRemoval() && GetKernelName().empty()){
         throw domain_error("You need to set the Kernel for Mean Trend Removal, before starting");
     }

# SW4 代表性輸入（mantissa-optimize）：LOH.1 幾何（30x30x17 km，層 + 半空間）
# 但材料帶深度梯度（非整數梯度 → rho、mu、lambda 幾乎全為完整 52 位尾數），
# 模擬真實 3D 速度模型（rfile/pfile）的情況。單顆 GH200、彈性、無衰減、Cartesian 網格。
fileio path=out-loh1gradf-h100 verbose=1
grid h=100 x=30000 y=30000 z=17000
time t=9
supergrid gp=30

# 半空間（z >= 1000 m）：vp/vs/rho 自地表起隨深度線性增加（非整數梯度）
block vp=5900 vs=3400 rho=2690 vpgrad=0.0731 vsgrad=0.0457 rhograd=0.0123 z1=1000
# 上層（z < 1000 m）
block vp=3800 vs=1800 rho=2580 vpgrad=0.1937 vsgrad=0.1811 rhograd=0.0217 z2=1000

source x=15000 y=15000 z=2000 mxy=1e18 t0=0.36 freq=16.6667 type=Gaussian

rec x=15600 y=15800 z=0 file=sta01 usgsformat=1
rec x=21000 y=23000 z=0 file=sta10 usgsformat=1
rec x=8000 y=11000 z=3000 file=sta20 usgsformat=1
